# Compiles the files the core needs beside it - data/, the built-in shaders
# (vita3k/shaders-builtin) and the icons of the system dialogs (vita3k/icons) -
# into the core, zipped and written out as a byte array, as the Cemu core does
# with its graphic packs. libretro_bundled.cpp unpacks them into
# system/vita3k when they are not this build's: a core from the buildbot is a
# single file, and the core may not download anything (sco8487).
function(vita3k_libretro_embed_files out_file)
    set(sources
        "data=${CMAKE_SOURCE_DIR}/data"
        "shaders-builtin=${CMAKE_SOURCE_DIR}/vita3k/shaders-builtin"
        "icons=${CMAKE_SOURCE_DIR}/vita3k/icons")
    set(stage_dir "${CMAKE_CURRENT_BINARY_DIR}/bundled_files_stage")
    set(zip_file "${CMAKE_CURRENT_BINARY_DIR}/bundled_files.zip")

    file(REMOVE_RECURSE "${stage_dir}")
    file(MAKE_DIRECTORY "${stage_dir}")
    foreach(source IN LISTS sources)
        string(REPLACE "=" ";" pair "${source}")
        list(GET pair 0 name)
        list(GET pair 1 dir)
        file(COPY "${dir}/" DESTINATION "${stage_dir}/${name}")
        # Configured again when one of them changes, so the core never carries old ones
        file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${dir}/*")
    endforeach()
    file(REMOVE "${zip_file}")
    file(GLOB entries RELATIVE "${stage_dir}" "${stage_dir}/*")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${zip_file}" --format=zip ${entries}
        WORKING_DIRECTORY "${stage_dir}" RESULT_VARIABLE tar_result)
    file(REMOVE_RECURSE "${stage_dir}")
    if(NOT tar_result EQUAL 0 OR NOT EXISTS "${zip_file}")
        message(FATAL_ERROR "libretro: could not zip the files compiled into the core")
    endif()

    file(SHA1 "${zip_file}" hash)
    file(READ "${zip_file}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," data "${hex}")
    message(STATUS "libretro: data, built-in shaders and icons compiled in (${size} bytes zipped)")
    file(WRITE "${out_file}.tmp"
        "// Generated by embed_system_files.cmake from data/, vita3k/shaders-builtin and vita3k/icons\n"
        "#include <cstddef>\n\n"
        "extern const unsigned char g_vita3k_bundled_zip[] = {${data}};\n"
        "extern const std::size_t g_vita3k_bundled_zip_size = ${size};\n"
        "extern const char g_vita3k_bundled_version[] = \"${hash}\";\n")
    file(COPY_FILE "${out_file}.tmp" "${out_file}" ONLY_IF_DIFFERENT)
endfunction()
